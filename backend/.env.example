# Copy to .env for local development — NEVER commit .env
DJANGO_SECRET_KEY=change-me-local-dev-only
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: HERE truck routing (https://platform.here.com/)
# Leave empty to use OSRM driving fallback (not truck-restricted)
HERE_API_KEY=
ROUTING_PROVIDER=here
